DATABASE_URL=postgresql://user:password@localhost:5432/vc_recruitment
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b. Model availability varies by
# account -- list yours at https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b

# Google Drive resume browsing (optional -- the tab reports "not configured"
# when these are blank). Read-only: resumes are parsed in memory, never saved
# to disk and never written to the database.
#
# The folder ID is the trailing segment of the Drive URL:
#   https://drive.google.com/drive/folders/<DRIVE_ROOT_FOLDER_ID>
# Share that folder with the service account's email as Viewer.
DRIVE_ROOT_FOLDER_ID=
DRIVE_SERVICE_ACCOUNT_FILE=

# Uploading a resume to Drive cannot use the service account -- service
# accounts own no storage quota. Uploads run as a real Google account:
#   1. Google Cloud console -> Credentials -> OAuth client ID -> Desktop app
#   2. Download the JSON and point DRIVE_OAUTH_CLIENT_FILE at it
#   3. Run: python scripts/drive_authorize.py
#   4. Put the token path it prints in DRIVE_OAUTH_TOKEN_FILE
# Leave blank and the Simulate resume button still works; only the upload
# step is skipped, with a warning on the submitted application.
DRIVE_OAUTH_CLIENT_FILE=
DRIVE_OAUTH_TOKEN_FILE=

