DATABASE_URL=postgresql://user:password@localhost:5432/vc_recruitment
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b. Model availability varies by
# account -- list yours at https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b

# Google Drive resume browsing (optional -- the tab reports "not configured"
# when these are blank). Read-only: resumes are parsed in memory, never saved
# to disk and never written to the database.
#
# The folder ID is the trailing segment of the Drive URL:
#   https://drive.google.com/drive/folders/<DRIVE_ROOT_FOLDER_ID>
# Share that folder with the service account's email as Viewer.
DRIVE_ROOT_FOLDER_ID=
DRIVE_SERVICE_ACCOUNT_FILE=
